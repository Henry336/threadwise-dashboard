{
  "name": "threadwise-dashboard",
  "version": "0.10.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run --exclude=e2e/**",
    "test:browser": "playwright test",
    "typecheck": "tsc --noEmit --incremental false",
    "security:scan-secrets": "node scripts/scan-tracked-secrets.mjs",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "security:audit:all": "npm audit --audit-level=high",
    "security:assurance": "vitest run src/lib/auth.test.ts src/lib/browser-session-registry.test.ts src/app/api/auth/logout/route.test.ts src/lib/proxy-allowlist.test.ts src/lib/proxy-security.test.ts src/app/api/threadwise/study-proxy.test.ts src/lib/content-security-policy.test.ts src/lib/study-markdown-security.test.ts src/lib/study-mermaid.test.ts src/lib/browser-drafts.test.ts src/lib/study-access.test.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tiptap/core": "^3.30.5",
    "@tiptap/extension-image": "^3.30.5",
    "@tiptap/extension-link": "^3.30.5",
    "@tiptap/extension-table": "^3.30.5",
    "@tiptap/extension-task-item": "^3.30.5",
    "@tiptap/extension-task-list": "^3.30.5",
    "@tiptap/markdown": "^3.30.5",
    "@tiptap/react": "^3.30.5",
    "@tiptap/starter-kit": "^3.30.5",
    "dompurify": "^3.4.13",
    "jose": "^6.1.0",
    "lucide-react": "^0.468.0",
    "mermaid": "^11.16.1",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "sharp": "0.35.3"
  }
}
